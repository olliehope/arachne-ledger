{
  "schemaVersion": 1,
  "id": "arachneledger",
  "version": "${version}",
  "name": "Arachne Ledger",
  "description": "Arachne loot, crystal costs, session and lifetime profit, hourly rates and graphs.",
  "authors": ["Arachne Ledger contributors"],
  "contact": {
    "sources": "https://github.com/olliehope/arachne-ledger",
    "issues": "https://github.com/olliehope/arachne-ledger/issues"
  },
  "license": "MIT",
  "icon": "assets/arachneledger/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.arachneledger.ArachneLedger"],
    "modmenu": ["dev.arachneledger.integration.ModMenuIntegration"]
  },
  "mixins": ["arachneledger.mixins.json"],
  "depends": {"fabricloader": ">=${fabric_loader_version}", "minecraft": "${minecraft_version}", "java": ">=25", "fabric-api": ">=${fabric_api_min_version}"},
  "suggests": {"modmenu": "*"}
}
